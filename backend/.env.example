# ==============================================================================
# VIT Shuttle — Backend Environment Variable Template
# ==============================================================================

FLASK_ENV=development
PORT=5000
HOST=0.0.0.0

SECRET_KEY=vit-shuttle-dev-secret-key-change-in-production-2026
JWT_SECRET_KEY=jwt-super-secret-vit-transit-key-2026

DATABASE_URL=sqlite:///instance/vit_shuttle.db
CORS_ORIGINS=*
