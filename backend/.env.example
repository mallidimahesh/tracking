STALE_GPS_THRESHOLD_SECONDS=30
OFFLINE_GPS_THRESHOLD_SECONDS=120
STALE_SENSOR_THRESHOLD_SECONDS=45
OFFLINE_SENSOR_THRESHOLD_SECONDS=150
