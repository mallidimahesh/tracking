# ==============================================================================
# VIT Shuttle — Environment Variable Template
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=production
PORT=5000
HOST=0.0.0.0

# Security Keys (Generate strong random secrets in production)
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-very-long-random-secret-key-32-chars-min
JWT_SECRET_KEY=replace-with-another-unique-random-jwt-secret-key

# Database
# For SQLite on persistent EBS:
DATABASE_URL=sqlite:////opt/vit-shuttle/data/vit_shuttle.db
# Future PostgreSQL Migration:
# DATABASE_URL=postgresql://vituser:password@localhost:5432/vitshuttle

# CORS Allowed Origins (Comma-separated, or * for initial testing)
CORS_ORIGINS=*

# Student Email Domain Restriction (Server-side enforced)
VIT_STUDENT_EMAIL_DOMAIN=@vitstudent.ac.in

# GPS and Sensor Staleness Thresholds (Seconds)
STALE_GPS_THRESHOLD_SECONDS=30
OFFLINE_GPS_THRESHOLD_SECONDS=120
STALE_SENSOR_THRESHOLD_SECONDS=45
OFFLINE_SENSOR_THRESHOLD_SECONDS=150

# JWT Expiration (Seconds - default 86400 = 24 hours)
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=86400
